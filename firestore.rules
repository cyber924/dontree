rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if resource.data.status == "published"
                  || (request.auth != null
                      && request.auth.token.email == "cyber924@naver.com");
      allow create, update, delete: if request.auth != null
                                    && request.auth.token.email == "cyber924@naver.com";
    }
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email == "cyber924@naver.com";
    }
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
                        "name", "email", "phone", "subject", "message", "status", "createdAt"
                      ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() >= 2
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.message.size() <= 3000
                    && request.resource.data.status == "new";
      allow read, update, delete: if request.auth != null
                                  && request.auth.token.email == "cyber924@naver.com";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
